{
  "compilerOptions": {
    "target": "ES2022",                          // Modern JavaScript features
    "module": "NodeNext",                        // Modern Node.js module resolution
    "moduleResolution": "NodeNext",
    "rootDir": "./src",                          // Source file location
    "outDir": "./dist",                          // Compiled production output location
    "strict": true,                              // Enforces strong type checking
    "esModuleInterop": true,                     // Clean imports for CommonJS modules
    "skipLibCheck": true  
                           // Faster compilation
  },
  "include": ["src/**/*"] ,
  "exclude": ["node_modules", "**/*.spec.ts", "drizzle.config.ts"]                      // Tells compiler to look only inside src
}
